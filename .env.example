# ─── Environment ──────────────────────────────────────────────────────────────
ENVIRONMENT=development                   # development | production
PLATFORM_BASE_URL=http://localhost:8000   # public URL — used to build PLATFORM_NOTIFY_URL

# ─── Database (pick ONE form, or leave blank for SQLite fallback) ─────────────
# 1) Explicit SQLAlchemy URL (takes precedence)
# DATABASE_URL=mysql+pymysql://user:pass@host:3306/dbname?charset=utf8mb4

# 2) MySQL via separate env vars
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=school_payments
# DB_USERNAME=root
# DB_PASSWORD=

# 3) Default: SQLite ./scolapp_payments.db

# ─── Secrets (REQUIRED) ───────────────────────────────────────────────────────
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_ENCRYPTION_KEY=

# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Optional: admin JWT lifetime (hours)
JWT_TTL_HOURS=24

# ─── Notes ────────────────────────────────────────────────────────────────────
# D-Money per-tenant credentials (appid / app_key / app_secret / private_key /
# merch_code / notify_url / redirect_url) are NO LONGER set globally here —
# they are stored per third-party in the DB, encrypted with MASTER_ENCRYPTION_KEY.
# Register each third party through the admin UI (/admin.html) or POST /admin/third-parties.
